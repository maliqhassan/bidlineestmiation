# Quote-form email settings.
# On Vercel: Project → Settings → Environment Variables (add each one, then redeploy).
# Locally: copy this file to .env.local.
# Without these, submissions are only logged to the console in development
# (and the form shows an error with your phone/email in production).

# Hostinger email (bidlineestimatingsolutions.com mail is hosted at Hostinger)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@bidlineestimatingsolutions.com
# The password of the info@ mailbox (Hostinger hPanel → Emails → manage mailbox)
SMTP_PASS=
# Where quote requests are delivered (defaults to the first email in src/lib/site.ts)
CONTACT_TO=info@bidlineestimatingsolutions.com
# Optional "from" address (defaults to SMTP_USER); must be the same mailbox on Hostinger
CONTACT_FROM=
