# Copy to .env.local and fill in to have quote-form submissions emailed to you.
# Without these, submissions are only logged to the console in development
# (and the form shows an error with your phone/email in production).

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@example.com
# For Gmail, use an App Password (Google Account → Security → App passwords)
SMTP_PASS=
# Where quote requests are delivered (defaults to the first email in src/lib/site.ts)
CONTACT_TO=info@bidlineestimating.com
# Optional "from" address (defaults to SMTP_USER)
CONTACT_FROM=
